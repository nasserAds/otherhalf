{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "otherhalf-backend": {
      "root": "backend/",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend",
      "destination": {
        "service": "otherhalf-backend"
      }
    },
    {
      "source": "/api/backend/(.*)",
      "destination": {
        "service": "otherhalf-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
