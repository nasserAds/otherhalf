{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "otherhalf-backend": {
      "root": "backend/",
      "framework": "nestjs",
      "buildCommand": "npm install && npx prisma generate && npm run build"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": {
        "service": "otherhalf-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
